# Environment Variables Template
# Copy to .env and fill in real keys (never commit .env)

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Preferred market data (FMP → Alpha Vantage → mock)
FMP_API_KEY=your_fmp_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Optional
MARKETAUX_API_KEY=
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Production (Render + Vercel)
# Comma-separated or JSON list of allowed frontend origins
CORS_ORIGINS=http://localhost:8443,https://your-app.vercel.app
PORT=8000
LOG_LEVEL=INFO
UVICORN_RELOAD=false

DEFAULT_TRACK_INTERVAL_MINUTES=5
MAX_VERIFICATION_RETRIES=2
